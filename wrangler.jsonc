{
  // 이 파일이 있으면 Cloudflare가 이 레포를 "Workers (정적 자산 포함)" 프로젝트로
  // 빌드/배포한다. worker/index.js가 /api/save를 처리하고, 나머지는 정적 파일로 서빙한다.
  "name": "portfolio-admin",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  // 대시보드의 Variables and Secrets가 이 Git 연동 빌드에 안 들어오는 문제 확인용 —
  // 이메일은 민감정보가 아니라서 여기 직접 넣어도 안전함. GITHUB_TOKEN은 절대 여기 넣지 말 것.
  "vars": {
    "ADMIN_EMAIL": "zzoddo329@naver.com"
  }
}
